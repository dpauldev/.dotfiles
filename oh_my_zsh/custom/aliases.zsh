# Navigation
alias dotfiles="cd ~/.dotfiles"
alias cd..="cd .."

# Shell
alias reload="source ~/.zshrc"

# Safety
set -o noclobber
alias rmi="rm -i"

# File operations
alias cpi="cp -iv"
alias mvi="mv -iv"

# Networking
alias cl="curl -L"

# Modern CLI tools
alias ll="eza -la"
alias lg="lazygit"
alias cat="bat"
