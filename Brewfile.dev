# Primary workstation extras — heavier dev/content-creation tools
# not needed on the lightweight spare machine.
#
# Loaded in addition to the shared Brewfile — see install_packages.sh.

tap "anomalyco/tap"

# =====================================
# Command Line Tools
# =====================================

brew "htop"
brew "jupyterlab"
brew "ripgrep"
brew "nghttp2"
brew "uv"
brew "ollama"
brew "anomalyco/tap/opencode-v2"

# =====================================
# Developer Productivity CLI
# =====================================

brew "gh"
brew "git-delta"
brew "lazygit"
brew "yq"
brew "httpie"

# =====================================
# Development Tools
# =====================================

cask "iterm2"
cask "claude"
cask "visual-studio-code"
cask "cursor"
cask "codex"
cask "postman"
cask "postman-cli"
cask "wireshark-app"
cask "textmate"
cask "google-gemini"

# =====================================
# Content Creation
# =====================================

cask "obs"
cask "audacity"
cask "iina"
cask "imageoptim"
cask "post-haste"

# =====================================
# Fonts and Documents
# =====================================

cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"

# =====================================
# Personal Applications
# =====================================

cask "anki"
cask "telegram"
